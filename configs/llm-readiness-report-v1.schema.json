{
  "$defs": {
    "FamilyReadinessReport": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "family_id": {
          "enum": [
            "hermes",
            "prometheus",
            "perseus",
            "atlas",
            "kronos",
            "aion"
          ],
          "title": "Family Id",
          "type": "string"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/ReadinessGate"
          },
          "maxItems": 11,
          "minItems": 11,
          "title": "Gates",
          "type": "array"
        },
        "ready_for_large_scale": {
          "title": "Ready For Large Scale",
          "type": "boolean"
        }
      },
      "required": [
        "family_id",
        "candidate_id",
        "gates",
        "ready_for_large_scale",
        "blockers"
      ],
      "title": "FamilyReadinessReport",
      "type": "object"
    },
    "ReadinessGate": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "passed",
        "observed",
        "requirement"
      ],
      "title": "ReadinessGate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "all_families_ready": {
      "title": "All Families Ready",
      "type": "boolean"
    },
    "capability_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capability Policy Sha256",
      "type": "string"
    },
    "decision_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Code Sha256",
      "type": "string"
    },
    "evaluator_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Sha256",
      "type": "string"
    },
    "evidence_schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Schema Sha256",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "family_reports": {
      "items": {
        "$ref": "#/$defs/FamilyReadinessReport"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Family Reports",
      "type": "array"
    },
    "production_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Production Policy Sha256",
      "type": "string"
    },
    "protocol_id": {
      "const": "olympus-six-family-readiness-v1",
      "default": "olympus-six-family-readiness-v1",
      "title": "Protocol Id",
      "type": "string"
    },
    "ready_families": {
      "maximum": 6,
      "minimum": 0,
      "title": "Ready Families",
      "type": "integer"
    },
    "report_schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Schema Sha256",
      "type": "string"
    },
    "safety_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Safety Policy Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "thresholds_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Thresholds Sha256",
      "type": "string"
    },
    "total_families": {
      "const": 6,
      "title": "Total Families",
      "type": "integer"
    }
  },
  "required": [
    "thresholds_sha256",
    "evidence_sha256",
    "evidence_schema_sha256",
    "report_schema_sha256",
    "capability_policy_sha256",
    "safety_policy_sha256",
    "production_policy_sha256",
    "evaluator_sha256",
    "decision_code_sha256",
    "family_reports",
    "ready_families",
    "total_families",
    "all_families_ready"
  ],
  "title": "PortfolioReadinessReport",
  "type": "object"
}
