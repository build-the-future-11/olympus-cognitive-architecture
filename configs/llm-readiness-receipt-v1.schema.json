{
  "$defs": {
    "DatasetAttestationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "dataset_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Manifest Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rights_review",
            "dataset_freeze"
          ],
          "title": "Kind",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "protocol_id": {
          "const": "olympus-six-family-readiness-v1",
          "title": "Protocol Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signer_key_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signer Key Id",
          "type": "string"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "kind",
        "dataset_manifest_sha256",
        "producer",
        "source_commit",
        "approved",
        "signer_key_id",
        "signature_base64"
      ],
      "title": "DatasetAttestationEnvelope",
      "type": "object"
    },
    "EvidenceReceiptEnvelope": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "checkpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "claim_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Claim Sha256",
          "type": "string"
        },
        "dataset_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Manifest Sha256",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "training",
            "control",
            "capability",
            "safety",
            "production",
            "reproduction",
            "family_gate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "protocol_id": {
          "const": "olympus-six-family-readiness-v1",
          "title": "Protocol Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signer_key_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signer Key Id",
          "type": "string"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "kind",
        "candidate_id",
        "checkpoint_sha256",
        "dataset_manifest_sha256",
        "producer",
        "source_commit",
        "evidence_id",
        "claim_sha256",
        "signer_key_id",
        "signature_base64"
      ],
      "title": "EvidenceReceiptEnvelope",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/EvidenceReceiptEnvelope"
    },
    {
      "$ref": "#/$defs/DatasetAttestationEnvelope"
    }
  ]
}
