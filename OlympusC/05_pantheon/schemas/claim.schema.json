{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pantheon Claim",
  "type": "object",
  "required": ["claim_id", "hypothesis", "primary_metric", "expected_direction", "blinded_replication"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "expected_direction": {"enum": ["positive", "negative", "none"]},
    "claim_boundary": {"type": "object"},
    "blinded_replication": {"type": "boolean"}
  },
  "additionalProperties": true
}
