OLYMPUS_FOUNDRY_ROOT=artifacts/foundry
OLYMPUS_OLLAMA_URL=http://127.0.0.1:11434
# Leave unset for loopback-only access; configure a nonempty secret for token mode.
# OLYMPUS_API_TOKEN=replace-with-an-operator-managed-secret
# Pin SHA-256 of reviewed public trust policy in protected release-runner configuration.
# Never derive this value from candidate input during promotion.
# OLYMPUS_PROMOTION_TRUST_SHA256=
